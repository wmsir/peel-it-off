.game-page {
  width: 100vw;
  height: 100vh;
  background-color: #faf6ee;
  display: flex;
  flex-direction: column;
  padding: 10rpx 16rpx calc(14rpx + env(safe-area-inset-bottom));
  position: relative;
  overflow: hidden;
}

.top-hud {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.level-pill {
  display: flex;
  align-items: center;
  background: #fffdf8;
  border: 2rpx solid #dfd5c4;
  border-radius: 999rpx;
  padding: 8rpx 20rpx 8rpx 10rpx;
}

.level-num {
  background: #2a241f;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  margin-right: 12rpx;
}

.level-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #2a241f;
}

.hud-right {
  display: flex;
  align-items: center;
}

.remain-badge {
  display: flex;
  align-items: center;
  background: #fffdf8;
  border: 2rpx solid #dfd5c4;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  margin-right: 10rpx;
}

.tape-dot {
  width: 22rpx;
  height: 12rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #ef476f, #f4b400);
  transform: rotate(-14deg);
  margin-right: 10rpx;
}

.remain-num {
  font-size: 26rpx;
  font-weight: 800;
}

.icon-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid #dfd5c4;
  background: #fffdf8;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.spool-dock {
  background: #fffdf8;
  border: 2rpx solid #dfd5c4;
  border-radius: 24rpx;
  padding: 10rpx 12rpx 6rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 6rpx 18rpx rgba(42, 36, 31, 0.06);
}

.spool-row {
  display: flex;
  justify-content: space-between;
}

.spool-slot {
  width: 31.5%;
  height: 96rpx;
  border-radius: 20rpx;
  background: #ece4d6;
  border: 2rpx dashed #cfc3af;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.spool-slot.active {
  background: #ffffff;
  border: 4rpx solid #cccccc;
  box-shadow: 0 6rpx 14rpx rgba(42, 36, 31, 0.08);
}

.spool-slot.locked {
  background: linear-gradient(180deg, #fffaf0, #f3e9d6);
  border: 2rpx dashed #d1a34b;
}

.spool-slot.popping {
  opacity: 0.3;
  transform: scale(0.9);
}

.spool-slot.bump {
  transform: scale(1.06);
}

.spool-core-wrap {
  display: flex;
  align-items: center;
}

.spool-ring {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
}

.spool-hole {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #f5efe3;
  border: 3rpx solid #c5b49a;
}

.spool-meta {
  display: flex;
  flex-direction: column;
}

.spool-color-name {
  font-size: 22rpx;
  font-weight: 800;
  color: #2a241f;
  margin-bottom: 8rpx;
}

.spool-pips {
  display: flex;
}

.spool-pip {
  width: 18rpx;
  height: 18rpx;
  border-radius: 5rpx;
  background: #e5dccb;
  margin-right: 6rpx;
}

.spool-locked-icon {
  font-size: 30rpx;
  line-height: 1.1;
}

.spool-locked-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #9e6b15;
  margin-top: 4rpx;
}

.spool-empty-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #a89d8c;
}

.queue-pill {
  margin-top: 6rpx;
  text-align: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #766a5e;
}

.tray-section {
  background: #ece4d6;
  border: 2rpx solid #d9cdb9;
  border-radius: 24rpx;
  padding: 8rpx 10rpx 10rpx;
  margin-bottom: 10rpx;
}

.tray-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.tray-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #2a241f;
}

.tray-tip {
  font-size: 20rpx;
  font-weight: 600;
  color: #766a5e;
}

.tray-tip.danger {
  color: #d62839;
  font-weight: 800;
}

.tray-slots {
  display: flex;
  justify-content: space-between;
}

.tray-slot {
  width: 15.2%;
  height: 68rpx;
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.88);
  border: 2rpx solid #d7cbb7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tray-slot.danger-pulse {
  border-color: #ef476f;
  background: #fff0f3;
}

.tray-slot.locked {
  background: #f6ecd7;
  border: 2rpx dashed #cfa14b;
}

.tray-lock-badge {
  font-size: 24rpx;
  line-height: 1.1;
}

.tray-lock-label {
  font-size: 18rpx;
  font-weight: 800;
  color: #9e6b15;
}

.tray-tape-chip {
  width: 72rpx;
  height: 42rpx;
  border-radius: 8rpx;
  transform: rotate(-10deg);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
}

.tray-chip-mark {
  font-size: 20rpx;
  font-weight: 900;
  color: rgba(255, 255, 255, 0.92);
}

.stage-wrap {
  position: relative;
  flex: 1;
  width: 100%;
  min-height: 540rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #f3ebdc 0%, #ebe1cf 100%);
  border: 3rpx solid #dcd0bc;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.stage-wrap.cutter-active {
  border-color: #ef476f;
}

.stage-wrap.fever-active {
  border-color: #f59e0b;
  box-shadow: inset 0 0 0 4rpx rgba(245, 158, 11, 0.48);
}

.fever-strip {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 10rpx;
  background: rgba(0, 0, 0, 0.06);
  z-index: 6;
  pointer-events: none;
}

.fever-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #ef476f);
}

.fever-label {
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #f59e0b, #ef4444);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  padding: 6rpx 22rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.board-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.mode-banner {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  right: 14rpx;
  background: rgba(42, 36, 31, 0.92);
  color: #ffffff;
  padding: 12rpx 18rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
}

.banner-cancel {
  background: rgba(255, 255, 255, 0.2);
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-weight: 700;
}

.film-hint {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(24, 24, 27, 0.85);
  color: #ffffff;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  display: flex;
  align-items: center;
}

.film-hint-arrow {
  margin-right: 10rpx;
  font-size: 28rpx;
}

.toast {
  position: absolute;
  bottom: 22rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(42, 36, 31, 0.9);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

.prop-bar {
  display: flex;
  justify-content: space-between;
}

.prop-btn {
  position: relative;
  width: 31.5%;
  background: #fffdf8;
  border: 2rpx solid #dfd5c4;
  border-radius: 24rpx;
  padding: 8rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 0 #d9cdb9;
}

.prop-btn.selected {
  border-color: #ef476f;
  background: #fff3f6;
}

.prop-icon {
  font-size: 34rpx;
  line-height: 1.15;
}

.prop-name {
  font-size: 22rpx;
  font-weight: 800;
  color: #2a241f;
  margin-top: 4rpx;
}

.prop-badge {
  position: absolute;
  top: -10rpx;
  right: -6rpx;
  min-width: 40rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #2a241f;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #faf6ee;
}

.prop-badge.ad-badge {
  background: linear-gradient(135deg, #f59e0b, #ea580c);
}

.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(24, 20, 17, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  z-index: 99;
}

.modal-card {
  width: 100%;
  background: #fffdf8;
  border-radius: 38rpx;
  border: 3rpx solid #dfd5c4;
  padding: 36rpx 32rpx;
  text-align: center;
}

.modal-emoji {
  font-size: 76rpx;
  margin-bottom: 10rpx;
}

.modal-title {
  font-size: 38rpx;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.modal-desc {
  font-size: 26rpx;
  color: #766a5e;
  margin-bottom: 28rpx;
}

.btn-primary {
  width: 100%;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ef476f, #e11d48);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  padding: 22rpx 24rpx;
  line-height: 1.3;
  margin-bottom: 18rpx;
}

.btn-primary.ad-cta {
  background: linear-gradient(135deg, #f59e0b, #ea580c);
}

.btn-ghost {
  width: 100%;
  border: 2rpx solid #dfd5c4;
  background: transparent;
  color: #766a5e;
  font-size: 26rpx;
  font-weight: 700;
  padding: 18rpx 20rpx;
  line-height: 1.3;
  border-radius: 22rpx;
}

.ad-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 800;
  color: #b45309;
  background: #fef3c7;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
}

.ad-screen {
  background: #1f1c19;
  color: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 24rpx;
}

.ad-emoji {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.ad-headline {
  font-size: 30rpx;
  font-weight: 800;
  color: #fde68a;
  margin-bottom: 10rpx;
}

.ad-sub {
  font-size: 22rpx;
  color: #d6cfc7;
  margin-bottom: 24rpx;
}

.ad-progress-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  overflow: hidden;
  margin-bottom: 14rpx;
}

.ad-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #f59e0b, #34d399);
}

.ad-countdown {
  font-size: 22rpx;
  color: #a8a29e;
}

.win-stamp {
  display: inline-block;
  background: #d1fae5;
  color: #065f46;
  font-size: 22rpx;
  font-weight: 900;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  margin-bottom: 18rpx;
}

.prize-reveal {
  background: linear-gradient(145deg, #fffbeb, #fef3c7);
  border: 3rpx solid #f59e0b;
  border-radius: 28rpx;
  padding: 24rpx 20rpx;
  margin-bottom: 24rpx;
}

.prize-icon {
  font-size: 72rpx;
  margin-bottom: 6rpx;
}

.prize-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #78350f;
  margin-bottom: 8rpx;
}

.prize-quote {
  font-size: 23rpx;
  color: #92400e;
  font-weight: 600;
}

.win-stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stat-item {
  width: 31%;
  background: #f5efe3;
  border-radius: 18rpx;
  padding: 14rpx 8rpx;
  display: flex;
  flex-direction: column;
}

.stat-label {
  font-size: 20rpx;
  color: #766a5e;
  margin-bottom: 4rpx;
}

.stat-val {
  font-size: 28rpx;
  font-weight: 900;
  color: #2a241f;
}

.jump-list {
  display: flex;
  flex-direction: column;
  max-height: 540rpx;
  margin: 20rpx 0 24rpx;
}

.jump-item {
  background: #f5efe3;
  border: 2rpx solid #dfd5c4;
  border-radius: 18rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.jump-item.active {
  background: #2a241f;
  color: #ffffff;
  border-color: #2a241f;
}
