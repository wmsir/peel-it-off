.app-wrap {
  width: 100vw;
  height: 100vh;
  background: #fffaf0;
  padding: 14rpx 20rpx 18rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.brand-chip {
  display: flex;
  flex-direction: column;
}

.chapter-pill {
  font-size: 20rpx;
  font-weight: 700;
  color: #854d0e;
  background: #fef3c7;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  align-self: flex-start;
}

.level-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #2c241e;
}

.endless-counter {
  font-size: 24rpx;
  font-weight: 800;
  color: #0369a1;
  background: #e0f2fe;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.top-actions {
  display: flex;
  gap: 10rpx;
}

.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 2rpx solid #e6d7c3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.mode-tabs {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  background: #efe6d7;
  padding: 6rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.mode-tab {
  text-align: center;
  padding: 10rpx 4rpx;
  font-size: 23rpx;
  font-weight: 800;
  color: #786a5c;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.mode-tab.active {
  background: #ffffff;
  color: #2c241e;
}

.tab-lock {
  font-size: 18rpx;
  color: #9a3412;
  background: #ffedd5;
  padding: 2rpx 6rpx;
  border-radius: 8rpx;
}

.goal-bar {
  margin-top: 12rpx;
  background: #ffffff;
  border: 2rpx solid #eadcc9;
  border-radius: 22rpx;
  padding: 12rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-shrink: 0;
}

.goal-left {
  flex: 1;
  min-width: 0;
}

.goal-sub {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #786a5c;
  margin-bottom: 6rpx;
}

.goal-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.goal-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #faf4ea;
  border: 2rpx solid #e7d8c5;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.goal-pill.done {
  background: #dcfce7;
  border-color: #86efac;
  color: #166534;
}

.goal-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 16rpx;
  font-weight: 900;
}

.moves-box {
  min-width: 108rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  background: #fef3c7;
  border: 2rpx solid #f59e0b;
  text-align: center;
  display: flex;
  flex-direction: column;
}

.moves-box.low {
  background: #ffe4e6;
  border-color: #e11d48;
}

.moves-label {
  font-size: 18rpx;
  color: #78350f;
}

.moves-val {
  font-size: 38rpx;
  font-weight: 900;
  color: #92400e;
}

.boost-strip,
.endless-bar {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff8ed;
  border: 2rpx dashed #d7b287;
  border-radius: 18rpx;
  padding: 8rpx 14rpx;
  flex-shrink: 0;
}

.boost-tip,
.ambient-label {
  font-size: 22rpx;
  font-weight: 800;
  color: #7c5832;
}

.boost-pill {
  background: #fffbeb;
  border: 2rpx solid #f59e0b;
  color: #92400e;
  border-radius: 14rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.ambient-pills {
  display: flex;
  gap: 8rpx;
}

.amb-btn {
  background: #ffffff;
  border: 2rpx solid #cbd5e1;
  border-radius: 14rpx;
  padding: 6rpx 12rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.amb-btn.active {
  background: #0284c7;
  border-color: #0284c7;
  color: #ffffff;
}

.stage-wrap {
  position: relative;
  flex: 1;
  margin-top: 12rpx;
  border-radius: 28rpx;
  overflow: hidden;
  border: 4rpx solid #b58756;
  background: #cf9e69;
}

.board-canvas {
  width: 100%;
  height: 100%;
  display: block;
}

.preview-pill {
  position: absolute;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(24, 24, 27, 0.85);
  color: #fde047;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
}

.mega-banner {
  position: absolute;
  top: 42%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #e11d48;
  color: #ffffff;
  padding: 16rpx 36rpx;
  border-radius: 28rpx;
  font-size: 46rpx;
  font-weight: 900;
}

.film-hint {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 250, 240, 0.94);
  border: 3rpx solid #f59e0b;
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  text-align: center;
}

.film-arrow {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
}

.film-text {
  font-size: 23rpx;
  font-weight: 800;
  color: #78350f;
}

.toast {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(44, 36, 30, 0.9);
  color: #ffffff;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.bottom-bar {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  flex-shrink: 0;
}

.foot-btn {
  background: #ffffff;
  border: 2rpx solid #e4d3bd;
  border-radius: 20rpx;
  text-align: center;
  padding: 14rpx 6rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.foot-btn.season-btn {
  background: #fff1f2;
  border-color: #fecdd3;
  color: #be123c;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(30, 22, 16, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  z-index: 99;
}

.modal-card {
  width: 100%;
  background: #fffaf2;
  border-radius: 32rpx;
  border: 3rpx solid #e9d9c3;
  padding: 28rpx 24rpx;
  text-align: center;
}

.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.head-t {
  font-size: 28rpx;
  font-weight: 900;
}

.close-x {
  font-size: 32rpx;
  font-weight: 900;
  padding: 4rpx 14rpx;
}

.modal-emoji { display: block; font-size: 72rpx; margin-bottom: 8rpx; }
.modal-title { display: block; font-size: 34rpx; font-weight: 900; margin-bottom: 10rpx; }
.modal-desc { display: block; font-size: 24rpx; color: #786a5c; margin-bottom: 20rpx; line-height: 1.5; }

.btn-primary {
  width: 100%;
  background: #e11d48;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 900;
  margin-bottom: 14rpx;
}

.btn-secondary {
  width: 100%;
  background: #fef3c7;
  color: #92400e;
  border: 2rpx solid #f59e0b;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.btn-ghost {
  width: 100%;
  background: #ffffff;
  color: #786a5c;
  border: 2rpx solid #dfd1be;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.btn-mini {
  background: #fffbeb;
  border: 2rpx solid #d7b287;
  color: #78350f;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.win-stars { display: block; font-size: 48rpx; color: #f59e0b; letter-spacing: 8rpx; }
.win-stamp { display: inline-block; font-size: 22rpx; font-weight: 800; color: #047857; background: #d1fae5; padding: 6rpx 18rpx; border-radius: 999rpx; margin: 10rpx 0 16rpx; }

.prize-box {
  background: #ffffff;
  border: 2rpx solid #f3e4cf;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.prize-icon { display: block; font-size: 76rpx; }
.prize-name { display: block; font-size: 30rpx; font-weight: 900; margin-top: 8rpx; }
.prize-quote { display: block; font-size: 22rpx; color: #786a5c; margin-top: 6rpx; }

.win-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 18rpx; }
.stat-item { background: #ffffff; border: 2rpx solid #efe3d2; border-radius: 18rpx; padding: 10rpx; }
.stat-l { display: block; font-size: 20rpx; color: #786a5c; }
.stat-v { font-size: 26rpx; font-weight: 900; }

.room-tabs { white-space: nowrap; margin-bottom: 12rpx; }
.room-tab { display: inline-block; padding: 8rpx 16rpx; margin-right: 8rpx; background: #ffffff; border: 2rpx solid #dfd1be; border-radius: 14rpx; font-size: 22rpx; font-weight: 800; }
.room-tab.active { background: #f59e0b; border-color: #f59e0b; color: #ffffff; }

.room-stage { position: relative; height: 280rpx; border-radius: 24rpx; border: 3rpx solid #d7b287; overflow: hidden; margin-bottom: 16rpx; }
.room-badge { position: absolute; top: 12rpx; left: 12rpx; background: rgba(255,255,255,0.88); padding: 4rpx 14rpx; border-radius: 12rpx; font-size: 22rpx; font-weight: 800; }
.room-chip { position: absolute; transform: translate(-50%, -50%); width: 76rpx; height: 76rpx; background: #ffffff; border: 2rpx solid #e6d6bf; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.room-chip.fine { border-color: #f59e0b; }
.room-chip.sel { border-color: #e11d48; border-width: 4rpx; }

.shared-cab { background: #ffffff; border: 2rpx solid #eadcc9; border-radius: 20rpx; padding: 14rpx; text-align: left; }
.cab-title { display: block; font-size: 22rpx; font-weight: 900; margin-bottom: 4rpx; }
.cab-sub { font-size: 21rpx; color: #786a5c; }

.cal-prog { display: block; font-size: 24rpx; font-weight: 800; margin-bottom: 14rpx; }
.cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; margin-bottom: 18rpx; }
.cal-day { background: #ffffff; border: 2rpx solid #e6d7c3; border-radius: 14rpx; padding: 14rpx 4rpx; font-size: 20rpx; font-weight: 800; }
.cal-day.lit { background: #fef3c7; border-color: #f59e0b; }

.skin-row { display: flex; justify-content: space-between; align-items: center; background: #ffffff; border: 2rpx solid #e7d8c5; border-radius: 20rpx; padding: 14rpx; margin-bottom: 10rpx; text-align: left; }
.skin-row.equipped { border-color: #e11d48; background: #fff1f2; }
.skin-name { display: block; font-size: 26rpx; font-weight: 900; }
.skin-desc { font-size: 20rpx; color: #786a5c; }

.season-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10rpx; }
.season-cell { background: #ffffff; border: 2rpx solid #fecdd3; border-radius: 16rpx; padding: 16rpx 4rpx; font-size: 22rpx; font-weight: 900; }
.season-cell.cleared { background: #dcfce7; border-color: #86efac; }

.setting-row { display: flex; justify-content: space-between; align-items: center; background: #ffffff; border: 2rpx solid #eadcc9; border-radius: 18rpx; padding: 16rpx 20rpx; margin-bottom: 12rpx; font-size: 26rpx; font-weight: 700; }
.toggle-pill { background: #e2e8f0; color: #334155; padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 800; }
.toggle-pill.on { background: #10b981; color: #ffffff; }

.ad-track { width: 100%; height: 16rpx; background: #e5e7eb; border-radius: 999rpx; overflow: hidden; margin: 18rpx 0; }
.ad-fill { height: 100%; background: #e11d48; }
