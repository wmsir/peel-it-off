<view class="game-page">
  <!-- 顶部 HUD -->
  <view class="top-hud">
    <view class="level-pill" bindtap="onToggleLevelDrawer">
      <text class="level-num">第 {{levelNum}} 关</text>
      <text class="level-title">{{levelTitle}} ▾</text>
    </view>
    <view class="hud-right">
      <view class="remain-badge">
        <view class="tape-dot"></view>
        <text class="remain-num">{{remainCount}}</text>
      </view>
      <view class="icon-btn" bindtap="onToggleSound">{{soundOn ? '🔊' : '🔇'}}</view>
      <view class="icon-btn" bindtap="onRestart">↻</view>
    </view>
  </view>

  <!-- 顶部：彩色胶带回收卷芯区 -->
  <view class="spool-dock">
    <view class="spool-row">
      <view
        wx:for="{{spoolsView}}"
        wx:key="slotIdx"
        class="spool-slot {{item.locked ? 'locked' : (item.empty ? 'empty' : 'active')}} {{item.popping ? 'popping' : ''}} {{item.bumping ? 'bump' : ''}}"
        style="{{!item.locked && !item.empty ? 'border-color:' + item.colorHex + ';' : ''}}"
        data-idx="{{item.slotIdx}}"
        bindtap="onSpoolTap"
      >
        <block wx:if="{{item.locked}}">
          <text class="spool-locked-icon">🎬</text>
          <text class="spool-locked-text">+1 回收卷芯</text>
        </block>
        <block wx:elif="{{item.empty}}">
          <text class="spool-empty-text">已清空 ✓</text>
        </block>
        <block wx:else>
          <view class="spool-core-wrap">
            <view
              class="spool-ring"
              style="background: conic-gradient({{item.colorHex}} {{item.fillPct}}%, #e9e1d4 0);"
            >
              <view class="spool-hole"></view>
            </view>
            <view class="spool-meta">
              <text class="spool-color-name">{{item.colorName}}</text>
              <view class="spool-pips">
                <view
                  wx:for="{{item.pips}}"
                  wx:for-item="pip"
                  wx:key="k"
                  class="spool-pip {{pip.filled ? 'filled' : ''}}"
                  style="{{pip.filled ? 'background:' + item.colorHex + ';' : ''}}"
                ></view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
    <view class="queue-pill">{{queueText}}</view>
  </view>

  <!-- 中部：手指暂存槽（5格 + 1个广告扩展格） -->
  <view class="tray-section">
    <view class="tray-header">
      <text class="tray-label">临时暂存区</text>
      <text class="tray-tip {{trayDanger ? 'danger' : ''}}">{{trayTipText}}</text>
    </view>
    <view class="tray-slots">
      <view
        wx:for="{{trayView}}"
        wx:key="slotIdx"
        class="tray-slot {{item.locked ? 'locked' : ''}} {{item.dangerPulse ? 'danger-pulse' : ''}}"
        data-idx="{{item.slotIdx}}"
        bindtap="onTrayTap"
      >
        <block wx:if="{{item.locked}}">
          <text class="tray-lock-badge">🎬</text>
          <text class="tray-lock-label">+1槽位</text>
        </block>
        <block wx:elif="{{item.colorHex}}">
          <view class="tray-tape-chip" style="background: {{item.colorHex}};">
            <text class="tray-chip-mark">{{item.mark}}</text>
          </view>
        </block>
      </view>
    </view>
  </view>

  <!-- 核心 Canvas 2D 舞台 -->
  <view class="stage-wrap {{cutterMode ? 'cutter-active' : ''}}">
    <canvas
      type="2d"
      id="board-canvas"
      class="board-canvas"
      disable-scroll="true"
      bindtouchstart="onCanvasTouchStart"
      bindtouchmove="onCanvasTouchMove"
      bindtouchend="onCanvasTouchEnd"
      bindtouchcancel="onCanvasTouchEnd"
    ></canvas>

    <view wx:if="{{cutterMode}}" class="mode-banner">
      <text class="banner-text">✂️ 破障美工刀就绪：点任意被压住胶带抽出</text>
      <view class="banner-cancel" bindtap="onCancelCutter">取消</view>
    </view>

    <view wx:if="{{showFilmHint}}" class="film-hint">
      <text class="film-hint-arrow">↓</text>
      <text>点一下或下滑，撕开最后一层保护膜！</text>
    </view>

    <view wx:if="{{toastMsg}}" class="toast">{{toastMsg}}</view>
  </view>

  <!-- 底部三大救命道具栏 -->
  <view class="prop-bar">
    <view class="prop-btn {{cutterMode ? 'selected' : ''}}" data-prop="cutter" bindtap="onPropTap">
      <text class="prop-icon">✂️</text>
      <text class="prop-name">破障美工刀</text>
      <view class="prop-badge {{propsView.cutter <= 0 ? 'ad-badge' : ''}}">
        {{propsView.cutter > 0 ? propsView.cutter : '🎬'}}
      </view>
    </view>
    <view class="prop-btn" data-prop="shuffle" bindtap="onPropTap">
      <text class="prop-icon">🌀</text>
      <text class="prop-name">换色洗牌</text>
      <view class="prop-badge {{propsView.shuffle <= 0 ? 'ad-badge' : ''}}">
        {{propsView.shuffle > 0 ? propsView.shuffle : '🎬'}}
      </view>
    </view>
    <view class="prop-btn" data-prop="magnet" bindtap="onPropTap">
      <text class="prop-icon">🧲</text>
      <text class="prop-name">一键收卷</text>
      <view class="prop-badge {{propsView.magnet <= 0 ? 'ad-badge' : ''}}">
        {{propsView.magnet > 0 ? propsView.magnet : '🎬'}}
      </view>
    </view>
  </view>

  <!-- 选关快速面板 -->
  <view wx:if="{{levelDrawerVisible}}" class="modal-backdrop" bindtap="onToggleLevelDrawer">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">选择体验关卡</view>
      <scroll-view scroll-y="true" class="jump-list">
        <view
          wx:for="{{levelChoices}}"
          wx:key="idx"
          class="jump-item {{levelNum === item.idx + 1 ? 'active' : ''}}"
          data-lvl="{{item.idx}}"
          bindtap="onJumpLevel"
        >
          第 {{item.idx + 1}} 关 · {{item.title}} ({{item.count}}条)
        </view>
      </scroll-view>
      <button class="btn-ghost" bindtap="onToggleLevelDrawer">关闭</button>
    </view>
  </view>

  <!-- 模拟激励视频广告弹窗（配置真实 adUnitId 后自动改走微信流量主） -->
  <view wx:if="{{adModal.visible}}" class="modal-backdrop">
    <view class="modal-card">
      <view class="ad-tag">微信流量主激励视频（演示模式）</view>
      <view class="ad-screen">
        <view class="ad-emoji">🍜💻</view>
        <view class="ad-headline">{{adModal.title}}</view>
        <view class="ad-sub">填写 utils/ad.js 中的 adUnitId 即可切换真实流量主广告</view>
        <view class="ad-progress-track">
          <view class="ad-progress-fill" style="width: {{adModal.progressPct}}%;"></view>
        </view>
        <view class="ad-countdown">{{adModal.countdownText}}</view>
      </view>
    </view>
  </view>

  <!-- 卡死失败 / 复活弹窗 -->
  <view wx:if="{{failModal.visible}}" class="modal-backdrop">
    <view class="modal-card">
      <view class="modal-emoji">😵‍💫</view>
      <view class="modal-title">胶带缠成死结了！</view>
      <view class="modal-desc">{{failModal.desc}}</view>
      <button class="btn-primary ad-cta" bindtap="onReviveTap">🎬 看广告复活（清空暂存区并收卷）</button>
      <button class="btn-ghost" bindtap="onFailRestartTap">不看广告，重新撕这关</button>
    </view>
  </view>

  <!-- 通关彩蛋弹窗 -->
  <view wx:if="{{winModal.visible}}" class="modal-backdrop">
    <view class="modal-card">
      <view class="win-stamp">强迫症极度舒适 ✓</view>
      <view class="prize-reveal">
        <view class="prize-icon">{{winModal.prizeIcon}}</view>
        <view class="prize-name">{{winModal.prizeName}}</view>
        <view class="prize-quote">{{winModal.prizeQuote}}</view>
      </view>
      <view class="win-stats">
        <view class="stat-item">
          <text class="stat-label">撕掉胶带</text>
          <text class="stat-val">{{winModal.totalTapes}} 条</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">最高连击</text>
          <text class="stat-val">x{{winModal.maxCombo}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-label">击败全国</text>
          <text class="stat-val">{{winModal.rankPct}}%</text>
        </view>
      </view>
      <button class="btn-primary" bindtap="onNextLevelTap">撕下一关 →</button>
      <button class="btn-ghost" open-type="share">📤 分享战绩给微信好友</button>
    </view>
  </view>
</view>
